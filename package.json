{
  "name": "doodle-jump",
  "version": "1.0.0",
  "description": "Doodle Jump as an embeddable microservice",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n srv,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon --watch server --watch shared server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node server/db/migrate.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dompurify": "^3.2.0",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "express-rate-limit": "^7.4.1",
    "file-type": "^19.6.0",
    "helmet": "^8.0.0",
    "jsdom": "^25.0.1",
    "jose": "^5.9.6",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "sharp": "^0.33.5",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.7",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
