# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# ─── Admin panel (fixed credentials) ──────────────────────
ADMIN_USERNAME=admin
# >= 12 chars in production
ADMIN_PASSWORD=change-me-please
# >= 32 random chars, e.g. `openssl rand -base64 48`
ADMIN_JWT_SECRET=
ADMIN_SESSION_HOURS=8

# ─── Players ──────────────────────────────────────────────
# >= 32 random chars
PLAYER_JWT_SECRET=
# Allow nickname (standalone) play without a host token
ALLOW_ANONYMOUS=true

# ─── Host integration ─────────────────────────────────────
# Shared secret used by the host to sign launch tokens (HS256). Empty = anonymous mode only
HOST_SIGNING_SECRET=
# Bearer key for /api/v1/events and player stats. Empty = integration API disabled
INTEGRATION_API_KEY=
# Comma-separated host origins allowed to call the API cross-origin
CORS_ORIGINS=
# CSP frame-ancestors value; also the postMessage origin allow-list (space-separated)
FRAME_ANCESTORS='self'

# ─── Webhook (optional; can also be set in admin settings) ─
WEBHOOK_URL=
WEBHOOK_SECRET=

# ─── Storage ──────────────────────────────────────────────
DB_PATH=./data/doodle.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=2

# ─── Anti-cheat & retention ───────────────────────────────
MAX_SCORE_RATE=450
EVENT_RETENTION_DAYS=180
